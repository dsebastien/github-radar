{
    "name": "github-radar",
    "version": "0.4.0",
    "description": "Keep every open GitHub issue and pull request across the users, organizations and repositories you care about on your radar. Static, private, runs entirely in your browser.",
    "author": {
        "name": "Sébastien Dubois",
        "email": "sebastien@developassion.be",
        "url": "https://dsebastien.net"
    },
    "keywords": [
        "github",
        "issues",
        "pull-requests",
        "dashboard",
        "github-pages"
    ],
    "license": "MIT",
    "private": true,
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dsebastien/github-radar.git"
    },
    "bugs": {
        "url": "https://github.com/dsebastien/github-radar/issues"
    },
    "homepage": "https://ghradar.dsebastien.net",
    "engines": {
        "node": ">=20.0.0"
    },
    "packageManager": "bun@1.4.2",
    "config": {
        "commitizen": {
            "path": "node_modules/cz-customizable"
        },
        "cz-customizable": {
            "config": ".cz-config.cjs"
        }
    },
    "scripts": {
        "dev": "vite",
        "build": "bun run tsc && vite build",
        "preview": "vite preview",
        "setup": "git config --local --replace-all include.path ../.gitconfig",
        "tsc": "tsc --noEmit",
        "tsc:watch": "tsc --noEmit --watch --preserveWatchOutput",
        "tscw": "bun run tsc:watch",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "bun test",
        "test:watch": "bun test --watch",
        "test:e2e": "playwright test",
        "validate": "bun run --parallel tsc test lint format:check",
        "commit": "cz",
        "cm": "cz",
        "commit:lint": "commitlint --edit"
    },
    "dependencies": {
        "clsx": "2.1.1",
        "react": "19.3.0",
        "react-dom": "19.3.0"
    },
    "devDependencies": {
        "@commitlint/cli": "21.2.2",
        "@commitlint/config-conventional": "21.2.2",
        "@commitlint/types": "21.2.0",
        "@eslint/js": "10.0.1",
        "@playwright/test": "1.63.0",
        "@tailwindcss/vite": "4.3.3",
        "@types/bun": "1.4.2",
        "@types/node": "24.13.3",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.1",
        "commitizen": "4.3.2",
        "cz-customizable": "7.5.4",
        "eslint": "10.10.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-react-refresh": "0.5.6",
        "globals": "17.12.0",
        "prettier": "3.9.6",
        "prettier-plugin-tailwindcss": "0.8.1",
        "tailwindcss": "4.3.3",
        "typescript": "6.0.3",
        "typescript-eslint": "8.70.0",
        "vite": "8.3.0"
    }
}
